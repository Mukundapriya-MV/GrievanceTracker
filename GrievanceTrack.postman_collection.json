            "description": "The scheduler keeps running every 30 s but must never create a second escalation for the same grievance. Grievance B will be escalated once and only once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Each grievance has at most one escalation', function () {",
                  "  const ids = pm.response.json().map(e => e.grievance.id);",
                  "  pm.expect(new Set(ids).size).to.equal(ids.length);",
                  "});",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
