{
  "info": {
    "name": "GrievanceTrack",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set staffApiKey before running requests that create departments/categories or update complaint status. Run folder 1 in order, then folder 2."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Staff-Key", "type": "string" },
      { "key": "value", "value": "{{staffApiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "1. Create department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Public Works\",\n  \"description\": \"Roads and bridges\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('departmentId', j.id);",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create category (Road Damage, SLA 3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Road Damage\",\n  \"slaDays\": 3,\n  \"department\": {\n    \"id\": \"{{departmentId}}\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('categoryId', j.id);",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Create grievance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"citizenName\": \"Asha Kumar\",\n  \"description\": \"Large pothole on the main road causing accidents\",\n  \"location\": \"MG Road, Ward 12\",\n  \"category\": {\n    \"id\": \"{{categoryId}}\"\n  }\n}"
            },
            "description": "Department is auto-routed from the category. slaDeadline = createdAt + 3 (minutes in demo mode)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('grievanceId', j.id);",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get grievance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Update status to IN_PROGRESS",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Wait ~3 minutes (demo mode) - then run step 7",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}"
              ]
            },
            "description": "MANUAL STEP: wait about 3 minutes (demo mode: 3 SLA days = 3 minutes, scheduler runs every 30 s) before sending step 7."
          }
        },
        {
          "name": "7. Check GET /escalations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/escalations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "escalations"
              ]
            },
            "description": "Expect escalatedToOfficer = 'Senior Public Works Officer', reason 'SLA exceeded'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Escalation exists', function () { pm.expect(pm.response.json().length).to.be.above(0); });",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Resolve",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Close",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Add rating 5",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/grievances/{{grievanceId}}/rating",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "grievances",
                "{{grievanceId}}",
                "rating"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
